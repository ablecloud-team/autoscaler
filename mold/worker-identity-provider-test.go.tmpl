package cloudstack

import (
    "context"
    "testing"
    "github.com/stretchr/testify/assert"
    v1 "k8s.io/api/core/v1"
    metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
)

func TestMoldRejectNonWorkerDeletion(t *testing.T) {
    for _, names := range [][]string{{"m1"}, {"unknown"}, {"vm1", "vm1"}} {
        asg := createASG()
        before := asg.cluster
        var nodes []*v1.Node
        for _, name := range names { nodes = append(nodes, &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: name}}) }
        assert.Error(t, DELETE_CALL)
        assert.Same(t, before, asg.cluster)
        asg.manager.service.(*mockCKSService).AssertNotCalled(t, "RemoveNodesFromCluster", testConfig.clusterID, nodeIDs)
    }
}

func TestMoldSyntheticIdentityAndControlExclusion(t *testing.T) {
    asg := createASG()
    worker, err := asg.manager.clusterForNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "external-cloudstack://vm2"}, Spec: v1.NodeSpec{ProviderID: "external-cloudstack://vm2"}})
    assert.NoError(t, err)
    assert.Same(t, asg, worker)
    group, err := asg.manager.clusterForNode(&v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "m1"}})
    assert.NoError(t, err)
    assert.Nil(t, group)
}
